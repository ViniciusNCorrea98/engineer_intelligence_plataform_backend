# Test-only PostgreSQL values. Copy to .env.test and use a unique local password.
EIP_TEST_DATABASE_NAME=eip_integration_test
EIP_TEST_DATABASE_USERNAME=eip_integration_test_user
EIP_TEST_DATABASE_PASSWORD=replace-with-a-test-only-password
EIP_TEST_DATABASE_PORT=55432
EIP_TEST_DATABASE_URL=jdbc:postgresql://localhost:55432/eip_integration_test
