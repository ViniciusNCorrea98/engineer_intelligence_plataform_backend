# Local PostgreSQL configuration for docker compose and the PostgreSQL test profile.
# Copy this file to .env and replace the password with a local, unique value.
EIP_DATABASE_NAME=eip_example
EIP_DATABASE_USERNAME=eip_example_user
EIP_DATABASE_PASSWORD=replace-with-a-local-password
EIP_DATABASE_URL=jdbc:postgresql://localhost:5433/eip_example
