# Git collector configuration. Keep the real service token in an ignored .env file.
EIP_API_URL=http://localhost:8080
EIP_PROJECT_ID=00000000-0000-0000-0000-000000000000
EIP_SOURCE_KEY=git
EIP_SERVICE_TOKEN=replace-with-the-issued-service-credential
EIP_GIT_REPOSITORY_PATH=C:\path\to\repository
EIP_GIT_REPOSITORY_REFERENCE=https://example.com/organization/repository.git
# Optional declared correlation:
# EIP_ACTIVITY_ID=00000000-0000-0000-0000-000000000000
# EIP_CORRELATION_CONFIDENCE=1.0
